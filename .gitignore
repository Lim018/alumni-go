# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build output
*.test
*.out

# Output of the go coverage tool
*.coverprofile
*.cov
*.coverage

# Go build cache and modules
bin/
vendor/
dist/
build/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# MacOS
.DS_Store

# Logs
*.log

# Environment files
.env
.env.local

# Temporary files
tmp/

